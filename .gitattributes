# Normalisasi line ending agar konsisten lintas OS (hindari diff/konflik karena CRLF).
* text=auto

*.php  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.sql  text eol=lf
*.json text eol=lf
*.html text eol=lf

# Berkas biner tidak boleh dinormalisasi
*.webp binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.pdf  binary
