# SIPEKA - Contoh konfigurasi environment
# Salin file ini menjadi .env lalu isi nilai sebenarnya:
#   cp .env.example .env
# File .env TIDAK boleh di-commit (sudah masuk .gitignore).
# =====================================================================

# Koneksi database PostgreSQL
DB_HOST=localhost
DB_PORT=port_postgre
DB_NAME=nama_database
DB_USER=postgres
DB_PASS=ubah_password_anda
