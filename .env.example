# =====================================================================
# SIPEKA - Contoh konfigurasi environment
# Salin file ini menjadi .env lalu isi nilai sebenarnya:
#   cp .env.example .env
# File .env TIDAK boleh di-commit (sudah masuk .gitignore).
# =====================================================================

# Koneksi database PostgreSQL
DB_HOST=localhost
DB_PORT=port_postgre
DB_NAME=nama_database
DB_USER=postgres
DB_PASS=ubah_password_anda

# Notifikasi email (SMTP Gmail)
# Isi dengan akun Gmail dan App Password (bukan password biasa).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME="SIPEKA"
MAIL_ENCRYPTION=tls
MAIL_ENABLED=false
